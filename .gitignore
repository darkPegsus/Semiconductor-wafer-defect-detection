# ==============================================================================
# Semiconductor Wafer Defect Detection - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Byte-compiled / Optimized / C-Extensions
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. Packaging & Distribution
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 4. Testing, Code Coverage & Linting Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
cover/
.cache
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 5. Jupyter Notebooks & IPython
# ------------------------------------------------------------------------------
.ipynb_checkpoints
*-checkpoint.ipynb
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & OS Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 7. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.key
*.pem

# ------------------------------------------------------------------------------
# 8. Experiment Tracking & Run Logs
# ------------------------------------------------------------------------------
logs/
*.log
runs/
wandb/
mlruns/
lightning_logs/

# ------------------------------------------------------------------------------
# 9. DATASET EXCLUSIONS (Strictly enforced: WM-811K raw & processed files)
# ------------------------------------------------------------------------------
data/raw/*
data/interim/*
data/processed/*

# Common binary data extensions
*.pkl
*.pickle
*.mat
*.npz
*.npy
*.h5
*.hdf5
*.parquet
*.feather
*.tar
*.tar.gz
*.zip
*.7z
*.gz

# Allow .gitkeep to maintain repository structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ------------------------------------------------------------------------------
# 10. MODEL WEIGHT EXCLUSIONS (Strictly enforced: Checkpoints & production weights)
# ------------------------------------------------------------------------------
models/checkpoints/*
models/production/*

# Serialized neural network weight extensions
*.pt
*.pth
*.pwf
*.onnx
*.safetensors
*.bin
*.engine

# Allow .gitkeep to maintain repository structure
!models/checkpoints/.gitkeep
!models/production/.gitkeep

# ------------------------------------------------------------------------------
# 11. Other Tracked Directory Placeholders
# ------------------------------------------------------------------------------
!notebooks/.gitkeep
!app/pages/.gitkeep
!app/assets/.gitkeep
!tests/test_fixtures/.gitkeep
