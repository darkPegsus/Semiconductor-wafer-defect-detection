# ==============================================================================
# Semiconductor Wafer Defect Detection - Environment Configuration Template
# Copy this file to .env and adjust variables as necessary for your local setup.
# ==============================================================================

# Data Storage Directories
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed

# Model Weights Directories
MODEL_CHECKPOINT_DIR=models/checkpoints
MODEL_PRODUCTION_DIR=models/production

# Compute & Runtime Settings
DEVICE=cuda
RANDOM_SEED=42
LOG_LEVEL=INFO

# Streamlit Application Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
